<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>M4IN Scripts Hub</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#0d0d0d;
    color:white;
}

header{
    background:#111;
    padding:20px;
    text-align:center;
    border-bottom:2px solid #1f1f1f;
}

header h1{
    font-size:40px;
    color:#00ff88;
}

header p{
    color:#999;
    margin-top:5px;
}

.container{
    max-width:1200px;
    margin:auto;
    padding:30px;
}

.script-box{
    background:#161616;
    border:1px solid #2a2a2a;
    padding:20px;
    border-radius:15px;
    margin-bottom:25px;
    transition:0.3s;
}

.script-box:hover{
    transform:scale(1.02);
    border-color:#00ff88;
}

.script-title{
    font-size:28px;
    margin-bottom:10px;
    color:#00ff88;
}

.script-desc{
    color:#aaa;
    margin-bottom:15px;
}

button{
    background:#00ff88;
    border:none;
    padding:12px 20px;
    border-radius:10px;
    cursor:pointer;
    font-weight:bold;
    transition:0.3s;
}

button:hover{
    background:#00cc6d;
}

.popup{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.8);
    display:none;
    justify-content:center;
    align-items:center;
    z-index:999;
}

.popup-content{
    background:#161616;
    padding:30px;
    border-radius:15px;
    width:90%;
    max-width:700px;
    text-align:center;
}

textarea{
    width:100%;
    height:150px;
    background:#0d0d0d;
    color:white;
    border:1px solid #333;
    padding:15px;
    border-radius:10px;
    margin-top:15px;
    resize:none;
}

.copy-btn{
    margin-top:15px;
}

.verify-box{
    margin-top:20px;
}

input[type="checkbox"]{
    transform:scale(1.5);
    margin-right:10px;
}

.footer{
    text-align:center;
    padding:30px;
    color:#666;
}
</style>
</head>
<body>

<header>
    <h1>M4IN Scripts Hub</h1>
    <p>Universal Roblox Scripts Collection</p>
</header>

<div class="container">

    <div class="script-box">
        <div class="script-title">💈 Be A Hair?</div>
        <div class="script-desc">Pastebin Script</div>
        <button onclick="openScript('https://pastebin.com/raw/DiivrieP')">Open Script</button>
    </div>

    <div class="script-box">
        <div class="script-title">Universal AutoClicker</div>
        <div class="script-desc">Mighty AutoClicker</div>
        <button onclick="openScript('https://rekonise.com/mighty-autoclicker-9cn91')">Open Script</button>
    </div>

    <div class="script-box">
        <div class="script-title">UGC Sniper</div>
        <div class="script-desc">
            Pass required to buy automatically.<br><br>
            DM if something wrong: m4in_scripts<br><br>
            Pass:
            <a style="color:#00ff88;" href="https://www.roblox.com/game-pass/894907564/15" target="_blank">
            Buy Pass
            </a>
        </div>
        <button onclick="openScript('https://rekonise.com/ugc-sniper-script-5gnre')">Open Script</button>
    </div>

    <div class="script-box">
        <div class="script-title">UGC Steal Points OP</div>
        <div class="script-desc">Universal Script</div>
        <button onclick="openScript('https://rekonise.com/ugc-steal-points-op-axf7n')">Open Script</button>
    </div>

    <div class="script-box">
        <div class="script-title">Universal Instant UGC</div>
        <div class="script-desc">Pastefy Script</div>
        <button onclick="openScript('https://pastefy.app/7lcXOSoA/raw')">Open Script</button>
    </div>

    <div class="script-box">
        <div class="script-title">Fake Purchase (🚨 MAY NOT WORK)</div>
        <div class="script-desc">Ragdoll Rumble</div>
        <button onclick="openScript('https://pastefy.app/GHzjwKju/raw')">Open Script</button>
    </div>

</div>

<div class="popup" id="popup">
    <div class="popup-content">

        <h2>Verification Required</h2>

        <div class="verify-box">
            <label>
                <input type="checkbox" id="verifyCheck">
                I'm not a robot
            </label>
        </div>

        <textarea id="scriptArea" readonly></textarea>

        <button class="copy-btn" onclick="copyScript()">Copy Script</button>

        <br><br>

        <button onclick="closePopup()">Close</button>

    </div>
</div>

<div class="footer">
    © 2026 M4IN Scripts Hub
</div>

<script>

let currentScript = "";

async function openScript(link){

    document.getElementById("popup").style.display = "flex";
    document.getElementById("scriptArea").value = "Verify first...";
    currentScript = link;

}

document.getElementById("verifyCheck").addEventListener("change", async function(){

    if(this.checked){

        try{

            const response = await fetch(currentScript);
            const text = await response.text();

            document.getElementById("scriptArea").value = text;

        }catch{

            document.getElementById("scriptArea").value = "Failed to load script.";

        }

    }else{

        document.getElementById("scriptArea").value = "Verify first...";

    }

});

function copyScript(){

    const area = document.getElementById("scriptArea");

    area.select();
    area.setSelectionRange(0,99999);

    navigator.clipboard.writeText(area.value);

    alert("Script copied!");

}

function closePopup(){

    document.getElementById("popup").style.display = "none";

    document.getElementById("verifyCheck").checked = false;

}

</script>

</body>
</html>
